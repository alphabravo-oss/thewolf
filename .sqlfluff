[sqlfluff]
# The migrations are a portable DDL subset written when Wolf also ran on SQLite.
# The sqlite dialect parses them; ansi or postgres raised PRS parse errors and
# dozens of false LT01s. PostgreSQL is the only runtime database now.
dialect = sqlite

# LT01 (whitespace) is auto-fixed by a one-time `sqlfluff fix` run on
# the migrations; keep the rule off afterward so cosmetic whitespace
# in future migrations doesn't churn findings.
exclude_rules = LT01

max_line_length = 160

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper
