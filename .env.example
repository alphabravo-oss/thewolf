# Copy this to `.env` (docker compose reads it automatically), then adjust.
#   cp .env.example .env && docker compose up -d --build
# Open http://127.0.0.1:8778 and log in with the admin below.

# --- First-run admin login ---
# An admin is created on first start when BOTH are set. Change the password.
WOLF_ADMIN_EMAIL=admin@wolf.local
WOLF_ADMIN_PASSWORD=change-me-at-least-8-chars

# --- JWT signing secret ---
# Leave empty to auto-generate + persist in the data volume (fine for a single
# instance). Set a fixed 32+ char value if you run multiple replicas.
WOLF_MASTER_KEY=

# --- Where the API listens (host side) ---
WOLF_BIND=127.0.0.1
WOLF_PORT=8778

# --- Repositories to scan ---
# Local-path repos must live UNDER this directory; it is bind-mounted read-only
# into the container at /repos. Put repos here (or symlink), then add them in
# the UI via "Add repo -> local -> Browse". GitHub repos (with a github_token
# secret) and SSH nodes do NOT need this bind.
WOLF_REPOS_ROOT=./repos

# --- Scanner images ---
# The bundled scanner images. NOTE: the published 2.0.0 images are currently
# arm64-only (Apple Silicon). On amd64 hosts, build/publish multi-arch images
# first (make scanners-build-all / the scanners-image CI workflow) or point
# these at images you host.
WOLF_SCANNERS_TAG=2.0.0
# Pull policy: IfNotPresent | Always | Never
WOLF_SCANNERS_PULL_POLICY=IfNotPresent

# --- Database ---
# Default is sqlite in the data volume (zero setup). To use Postgres instead,
# run `docker compose --profile postgres up` and set:
# WOLF_DB_DRIVER=postgres
# WOLF_DB_DSN=postgres://wolf:CHANGEME@postgres:5432/wolf?sslmode=disable
WOLF_DB_DRIVER=sqlite

# Postgres password (only used with the `postgres` profile).
POSTGRES_PASSWORD=change-me-postgres
