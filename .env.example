# Copy this to `.env` (docker compose reads it automatically), then adjust.
#   cp .env.example .env && docker compose up -d --build
# Open http://127.0.0.1:8778 and log in with the admin below.

# --- First-run admin login ---
# An admin is created on first start when BOTH are set. Change the password.
WOLF_ADMIN_EMAIL=admin@wolf.local
WOLF_ADMIN_PASSWORD=change-me-at-least-12-chars

# --- JWT signing secret ---
# Leave empty to auto-generate + persist in the data volume (fine for a single
# instance). For API/worker replicas, set the same 32-byte key encoded as 64
# hexadecimal characters (for example: openssl rand -hex 32).
WOLF_MASTER_KEY=

# --- Where the API listens (host side) ---
WOLF_BIND=127.0.0.1
WOLF_PORT=8778

# --- Repositories to scan ---
# Local-path repos must live UNDER this directory; it is bind-mounted read-only
# into the container at /repos. Put repos here (or symlink), then add them in
# the UI via "Add repo -> local -> Browse". GitHub repos (with a github_token
# secret) and SSH nodes do NOT need this bind.
WOLF_REPOS_ROOT=/absolute/path/to/wolf/repos
# Host path seen by the Docker daemon for the /repos bind. In Compose this
# usually matches WOLF_REPOS_ROOT.
WOLF_HOST_REPOS_ROOT=/absolute/path/to/wolf/repos
# One-shot Git/SSH snapshots are staged here so the worker and child scanner
# containers see the same host bind. This must be an absolute host path.
WOLF_HOST_WORKSPACE_ROOT=/absolute/path/to/wolf/workspaces

# --- Durable scan workers ---
# Queue is the Compose default. Set inline only for rollback to the legacy
# API-process executor. SQLite supports one effective worker.
WOLF_SCAN_EXECUTION_MODE=queue
WOLF_SCAN_WORKERS=1
WOLF_SCAN_WORKER_CAPACITY=1
# Comma-separated CIDRs that private Git hosts may resolve into.
WOLF_GIT_ALLOWED_CIDRS=

# --- Scanner release scheduling, discovery, and build factory ---
# Staged control-plane enablement:
#   disabled | read_only | candidate | canary | stable_control
# Fail-closed default: observe existing release state without changing scan
# assignment. Advance explicitly only after the corresponding gates pass.
WOLF_SCANNER_RELEASE_MODE=read_only
# Keep the synchronous legacy scanner-image build endpoints during migration.
# Set false only after all callers use durable release operations.
WOLF_SCANNER_LEGACY_BUILD_ENDPOINTS=true
# Durable fixed-context Custom build execution is independently opt-in:
#   docker compose --profile scanner-custom-build up -d
# The API only enqueues; this worker alone resolves DockerHub credentials and
# receives the image-engine socket.
WOLF_SCANNER_CUSTOM_BUILD_WORKERS=1
WOLF_SCANNER_CUSTOM_BUILD_POLL_INTERVAL=2s
WOLF_SCANNER_CUSTOM_BUILD_HEARTBEAT_INTERVAL=10s
WOLF_SCANNER_CUSTOM_BUILD_LEASE_DURATION=45s
WOLF_SCANNER_CUSTOM_BUILD_OPERATION_TIMEOUT=2h
# Hardened Compose defaults to a reviewed immutable multi-platform proxy
# image. Override only with another tag@sha256 reference after validation.
# WOLF_DOCKER_SOCKET_PROXY_IMAGE=tecnativa/docker-socket-proxy:v0.5.0@sha256:1f5038b54f06c3e18422902cf00ba21803d1c97805aae032e5e6673d532d3459
# Prefer a dedicated/rootless image engine socket.
# WOLF_SCANNER_CUSTOM_BUILD_ENGINE_SOCKET=/run/user/1000/docker.sock
# Opt in to the scheduler, discovery, and rollout-controller services with:
#   docker compose --profile scanner-release up -d
# This must identify the immutable scanner-definition Git commit used to
# create discovery and candidate records. Do not use a branch name.
WOLF_SCANNER_DEFINITION_COMMIT=
WOLF_SCANNER_RELEASE_TIMEZONE=UTC
WOLF_SCANNER_RELEASE_DAILY_TIME=02:00
WOLF_SCANNER_RELEASE_WEEKLY_TIME=03:00
WOLF_SCANNER_RELEASE_WEEKLY_DAY=Sunday
WOLF_SCANNER_RELEASE_POLICY_SCOPE=global
# Discovery definitions are baked into the standard image. Override these
# paths only when mounting an operator-managed definition bundle.
# WOLF_SCANNER_DISCOVERY_MANIFEST=/definitions/tools.yaml
# WOLF_SCANNER_DISCOVERY_LOCK=/definitions/scanner-lock.yaml
WOLF_SCANNER_DISCOVERY_WORKERS=1
# Definition proposal workers are a separate profile because their Go-capable
# executor image and Git credentials are not part of the normal Wolf image:
#   docker compose --profile scanner-release-proposal up -d
WOLF_SCANNER_PROPOSAL_REPOSITORY_URL=
WOLF_SCANNER_PROPOSAL_GITHUB_API=https://api.github.com
WOLF_SCANNER_PROPOSAL_GITHUB_OWNER=
WOLF_SCANNER_PROPOSAL_GITHUB_REPOSITORY=thewolf
# Prefer an orchestrator-mounted file and set the *_FILE path. The environment
# value exists for local development only and must not be committed.
WOLF_SCANNER_PROPOSAL_GITHUB_TOKEN=
WOLF_SCANNER_PROPOSAL_GITHUB_TOKEN_FILE=
WOLF_SCANNER_PROPOSAL_BASE_BRANCH=main
WOLF_SCANNER_PROPOSAL_BRANCH_PREFIX=wolf/scanner-release
WOLF_SCANNER_PROPOSAL_LABELS=scanner-release
WOLF_SCANNER_PROPOSAL_REQUIRE_STATUS=true
WOLF_SCANNER_PROPOSAL_WORKERS=1
WOLF_SCANNER_PROPOSAL_POLL=3s
WOLF_SCANNER_PROPOSAL_HEARTBEAT=10s
WOLF_SCANNER_PROPOSAL_LEASE_DURATION=45s
WOLF_SCANNER_PROPOSAL_DRAIN_TIMEOUT=1m
# Notification delivery is independently opt-in:
#   docker compose --profile scanner-release-notifications up -d
# Install shell-free webhook/email/SIEM adapter executables in this directory.
# The adapters resolve opaque policy aliases and read deployment-owned secrets.
WOLF_SCANNER_NOTIFICATION_ADAPTERS_HOST=./deploy/scanner-notification-adapters
WOLF_SCANNER_NOTIFICATION_WORKERS=1
WOLF_SCANNER_NOTIFICATION_POLL=2s
WOLF_SCANNER_NOTIFICATION_HEARTBEAT=10s
WOLF_SCANNER_NOTIFICATION_LEASE_DURATION=45s
WOLF_SCANNER_NOTIFICATION_DELIVERY_TIMEOUT=30s
WOLF_SCANNER_NOTIFICATION_DRAIN_TIMEOUT=1m
WOLF_SCANNER_NOTIFICATION_BASE_BACKOFF=15s
WOLF_SCANNER_NOTIFICATION_MAX_BACKOFF=30m
# Comma-separated variable names explicitly inherited by adapter children.
# Prefer *_FILE values backed by Compose secrets or read-only secret mounts.
# WOLF_SCANNER_NOTIFICATION_ADAPTER_ENV=WEBHOOK_CONFIG_FILE,SMTP_CONFIG_FILE
# Replica-safe rollout controllers. Keep at 1 for SQLite; PostgreSQL supports
# multiple replicas with exact-token lease ownership and stale takeover.
WOLF_SCANNER_ROLLOUT_WORKERS=1
# A build-role process also requires a shell-free JSON executor binary:
# WOLF_SCANNER_RELEASE_EXECUTOR=/opt/wolf-release-executor/runner
# Complete managed factory (Buildx Kubernetes driver + release Jobs):
#   bash deploy/compose/tests/managed-config.sh
#   docker compose --profile scanner-release-managed up -d \
#     scanner-release-managed-builder
# All images below must use image@sha256:<64-lowercase-hex>. All host mount
# sources must be absolute paths. The backend additionally verifies that the
# mounted Buildx config.json contains exactly the immutable primary target host.
WOLF_SCANNER_RELEASE_SOURCE_URL=
WOLF_SCANNER_RELEASE_PRIMARY_REGISTRY_ID=
WOLF_SCANNER_RELEASE_MIRROR_REGISTRY_ID=
WOLF_SCANNER_RELEASE_WORKSPACE_HOST=
WOLF_SCANNER_RELEASE_WORKSPACE_PVC=
WOLF_SCANNER_RELEASE_STEP_IMAGE=
WOLF_SCANNER_RELEASE_K8S_API_SERVER=https://kubernetes.default.svc
WOLF_SCANNER_RELEASE_K8S_NAMESPACE=
# Stable instance label used by operator-created lane NetworkPolicies.
WOLF_SCANNER_RELEASE_K8S_INSTANCE=wolf-compose
WOLF_SCANNER_RELEASE_BUILDX_NAMESPACE=
WOLF_SCANNER_RELEASE_BUILDKIT_SERVICE_ACCOUNT=
WOLF_SCANNER_RELEASE_KUBECONFIG_HOST_FILE=
WOLF_SCANNER_RELEASE_K8S_TOKEN_HOST_FILE=
WOLF_SCANNER_RELEASE_K8S_CA_HOST_FILE=
WOLF_SCANNER_RELEASE_BUILDX_DOCKER_CONFIG_HOST_DIR=
WOLF_SCANNER_RELEASE_MANAGED_BUILDERS=1
# Optional for a private credential-free HTTPS source. The file contains only
# the bounded HTTP Authorization value and is mounted read-only.
WOLF_SCANNER_RELEASE_GIT_AUTHORIZATION_HOST_FILE=
# Set the in-container path only when the optional host file above is used.
# WOLF_SCANNER_RELEASE_GIT_AUTHORIZATION_FILE=/run/wolf/git/authorization
WOLF_SCANNER_RELEASE_FIXED_ADAPTER_IMAGE=
# Required even with workload identity. Kubernetes Secret containing only
# target-bound config.json registry auth.
WOLF_SCANNER_RELEASE_FIXED_REGISTRY_CREDENTIAL_SECRET=
WOLF_SCANNER_RELEASE_FIXED_REGISTRY_CREDENTIAL_WORKLOAD_IDENTITY=false
WOLF_SCANNER_RELEASE_FIXED_SERVICE_ACCOUNT=
WOLF_SCANNER_RELEASE_QUALITY_ADAPTER_IMAGE=
# Required even with workload identity. The Secret contains exactly
# config.json, engine.json, ca.pem, cert.pem, and key.pem for a remote Docker
# Engine over mTLS; no host engine socket is mounted. engine.json may name an
# internal, labelled wolf-quality-* fixture network only when it also binds an
# exact quality_network_policy_digest. Nuclei qualification additionally uses
# quality_targets.nuclei with an http://wolf-quality-*:unprivileged-port URL;
# otherwise qualification uses no network.
WOLF_SCANNER_RELEASE_QUALITY_REGISTRY_CREDENTIAL_SECRET=
WOLF_SCANNER_RELEASE_QUALITY_ENGINE_CREDENTIAL_SECRET=
WOLF_SCANNER_RELEASE_QUALITY_REGISTRY_CREDENTIAL_WORKLOAD_IDENTITY=false
WOLF_SCANNER_RELEASE_QUALITY_SERVICE_ACCOUNT=
WOLF_SCANNER_RELEASE_INTEGRATION_ADAPTER_IMAGE=
# Same exact remote-engine Secret contract as the quality lane.
WOLF_SCANNER_RELEASE_INTEGRATION_REGISTRY_CREDENTIAL_SECRET=
WOLF_SCANNER_RELEASE_INTEGRATION_ENGINE_CREDENTIAL_SECRET=
WOLF_SCANNER_RELEASE_INTEGRATION_REGISTRY_CREDENTIAL_WORKLOAD_IDENTITY=false
WOLF_SCANNER_RELEASE_INTEGRATION_SERVICE_ACCOUNT=
WOLF_SCANNER_RELEASE_ADAPTER_PATH=/usr/local/bin/wolf-release-adapter
#
# Customer KMS/HSM/keyless/offline signing. The profile contains opaque
# references only; the shell-free adapter owns all private-key access.
# WOLF_SCANNER_SIGNER_PROFILE_FILE=/run/wolf/signing/profile.json
# WOLF_SCANNER_SIGNER_PROFILE_HOST_FILE=/absolute/host/path/profile.json
# WOLF_SCANNER_SIGNER_CREDENTIAL_HOST_DIR=/absolute/host/path/credentials
# WOLF_SCANNER_SIGNER_ADAPTER=/usr/local/bin/wolf-signer-adapter
# WOLF_SCANNER_SIGNER_JOURNAL=/var/lib/wolf/scanner-signing-journal
# WOLF_SCANNER_SIGNER_NETWORK=none
# Managed mode mounts a coordinator signer adapter and also names the signer
# Secret/service account used only by signing Jobs.
WOLF_SCANNER_SIGNER_ADAPTER_HOST_FILE=
WOLF_SCANNER_SIGNER_PROFILE_SECRET=
WOLF_SCANNER_SIGNER_CREDENTIAL_SECRET=
WOLF_SCANNER_SIGNER_WORKLOAD_IDENTITY=false
WOLF_SCANNER_RELEASE_SIGNER_SERVICE_ACCOUNT=
# Comma-separated provider-specific variables explicitly allowed into the
# coordinator signer adapter; do not include WOLF_* control variables.
WOLF_SCANNER_SIGNER_ENV=
# Import trust is public verification policy, documented in the runbook.
# WOLF_SCANNER_BUNDLE_TRUST_POLICY_FILE=/etc/wolf/scanner-bundle-trust.json
# Compose mounts host files at fixed, read-only container paths. Set both the
# host source and the corresponding container variable to enable a boundary.
# WOLF_SCANNER_BUNDLE_TRUST_POLICY_HOST_FILE=/absolute/host/path/bundle-trust.json
# WOLF_SCANNER_BUNDLE_TRUST_POLICY_FILE=/run/wolf/offline-bundles/portable/trust-policy.json
# WOLF_SCANNER_BUNDLE_IMAGE_VERIFIER_HOST_FILE=/absolute/host/path/offline-image-verifier
# WOLF_SCANNER_BUNDLE_IMAGE_VERIFIER=/run/wolf/offline-bundles/images/verifier
# WOLF_SCANNER_BUNDLE_IMAGE_TRUST_POLICY_HOST_FILE=/absolute/host/path/image-trust.json
# WOLF_SCANNER_BUNDLE_IMAGE_TRUST_POLICY_FILE=/run/wolf/offline-bundles/images/trust-policy.json

# --- Scanner images ---
# The bundled scanner images. NOTE: the published 2.0.0 images are currently
# arm64-only (Apple Silicon). On amd64 hosts, build/publish multi-arch images
# first (make scanners-build-all / the scanners-image CI workflow) or point
# these at images you host.
WOLF_SCANNERS_TAG=2.0.0
# Pull policy: IfNotPresent | Always | Never
WOLF_SCANNERS_PULL_POLICY=IfNotPresent

# --- Database ---
# Default is sqlite in the data volume (zero setup). To use Postgres instead,
# run `docker compose --profile postgres up` and set:
# WOLF_DB_DRIVER=postgres
# WOLF_DB_DSN=postgres://wolf:CHANGEME@postgres:5432/wolf?sslmode=disable
WOLF_DB_DRIVER=sqlite

# Postgres password (only used with the `postgres` profile).
POSTGRES_PASSWORD=change-me-postgres

# --- TLS / public deployment (the `proxy` profile) ---
# Wolf is HTTP-only by design; the Caddy reverse proxy terminates TLS. Bring it
# up with:  docker compose --profile proxy up -d --build
# It already sets X-Forwarded-Proto, so wolf marks session cookies Secure.
#
# The domain you'll serve wolf on (must point at this host's public IP).
WOLF_DOMAIN=wolf.example.com
# When the proxy is up, set this to your public origin so CORS matches.
# WOLF_CORS_ORIGINS=https://wolf.example.com
#
# TLS mode 1 — AUTOMATIC (Let's Encrypt). Just set the ACME contact email.
ACME_EMAIL=you@example.com
#
# TLS mode 2 — BRING YOUR OWN CERT. Point CADDYFILE at the byocert config and
# WOLF_TLS_DIR at a directory containing cert.pem + key.pem (full chain). Then
# ACME_EMAIL is ignored.
# CADDYFILE=./deploy/Caddyfile.byocert
# WOLF_TLS_DIR=/absolute/path/to/your/certs
#
# When fronting with the proxy, stop publishing wolf's own port to the world
# (keep it on localhost; the proxy reaches wolf over the internal network):
# WOLF_BIND=127.0.0.1
