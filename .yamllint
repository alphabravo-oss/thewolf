# yamllint config — extends default, then relaxes rules that fire on
# GitHub Actions templating (`${{ … }}` inside flow scalars trips
# braces/commas), and on YAML conventions wolf doesn't enforce
# (document-start, truthy `on:` keyword).
extends: default

rules:
  line-length:
    max: 160
    level: warning
  braces: disable
  commas: disable
  document-start: disable
  truthy:
    check-keys: false
  # GitHub Action SHA-pinning convention is `<repo>@<sha> # <ver>` —
  # exactly one space between the value and the `#` comment marker.
  # yamllint's default `comments: { min-spaces-from-content: 2 }`
  # flags it. Allowing 1 space matches the de-facto convention
  # and keeps the renovate-friendly format intact.
  comments:
    min-spaces-from-content: 1

ignore: |
  ui-next/node_modules/
  FINDINGS/
