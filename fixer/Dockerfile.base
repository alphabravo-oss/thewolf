# ============================================================
# checkov:skip=CKV_DOCKER_2 — fixer images are worker containers driven by
# `wolf fixer`, not network services.
#
# Wolf fixer shared base. All network-fetched tools are exact-version and
# checksum/integrity pinned. OS packages come from the same immutable snapshot
# contract as scanner images. The release lock includes this Dockerfile,
# fixer/versions.env, go.mod/go.sum, and the complete Wolf source inputs.
# ============================================================

FROM debian:trixie-slim@sha256:4e401d95de7083948053197a9c3913343cd06b706bf15eb6a0c3ccd26f436a0e AS build

ARG WOLF_VERSION=dev
ARG GO_VERSION=1.26.6
ARG GO_LINUX_AMD64_SHA256=708effb774be8237570d0add163225abbdfaf4fca28b2611df167beba4feef89
ARG GO_LINUX_ARM64_SHA256=d0507e9e9d7fe012aae570108cbd76c15de879e17130ab8cb90d4d7445cb1f2e
ARG TYPESCRIPT_VERSION=6.0.3
ARG TYPESCRIPT_INTEGRITY=sha512-y2TvuxSZPDyQakkFRPZHKFm+KKVqIisdg9/CZwm9ftvKXLP8NRWj38/ODjNbr43SsoXqNuAisEf1GdCxqWcdBw==
ARG GH_VERSION=2.97.0
ARG GLAB_VERSION=1.113.0

LABEL org.opencontainers.image.title="wolf-fixer" \
      org.opencontainers.image.description="Autonomous remediation worker base for The Wolf" \
      org.opencontainers.image.source="https://github.com/alphabravo-oss/thewolf" \
      org.opencontainers.image.vendor="AlphaBravo" \
      org.opencontainers.image.version="${WOLF_VERSION}" \
      dev.wolf.fixer.variant="base" \
      dev.wolf.fixer.auth-mode="none"

ENV DEBIAN_FRONTEND=noninteractive \
    WOLF_FIXER_VARIANT=base \
    GOTOOLCHAIN=local \
    PATH=/usr/local/go/bin:/home/wolf/go/bin:/usr/local/bin:/usr/bin:/bin

COPY scanners/os-packages /etc/wolf-scanners/os-packages
COPY scanners/install/os-packages.sh /usr/local/bin/install-os-packages
RUN chmod 0755 /usr/local/bin/install-os-packages \
    && /usr/local/bin/install-os-packages fixer-base \
    && rm -f /usr/local/bin/install-os-packages

RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) goarch=amd64; go_sha="$GO_LINUX_AMD64_SHA256" ;; \
      arm64) goarch=arm64; go_sha="$GO_LINUX_ARM64_SHA256" ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 65 ;; \
    esac; \
    curl --proto '=https' --tlsv1.2 --fail --location --silent --show-error \
      --proto-redir '=https' --retry 3 --retry-all-errors \
      "https://go.dev/dl/go${GO_VERSION}.linux-${goarch}.tar.gz" -o /tmp/go.tgz; \
    printf '%s  %s\n' "$go_sha" /tmp/go.tgz | sha256sum --check --strict -; \
    tar -C /usr/local -xzf /tmp/go.tgz; \
    rm /tmp/go.tgz; \
    test "$(/usr/local/go/bin/go version | awk '{print $3}')" = "go${GO_VERSION}"

COPY fixer/versions.env /tmp/fixer-versions.env
COPY fixer/install-node-tools.sh /tmp/install-node-tools.sh
COPY fixer/install-fix-tools.sh /tmp/install-fix-tools.sh
RUN chmod 0755 /tmp/install-node-tools.sh /tmp/install-fix-tools.sh \
    && /tmp/install-node-tools.sh /tmp/fixer-versions.env \
    && /tmp/install-fix-tools.sh /tmp/fixer-versions.env

COPY fixer/go-tools /tmp/fixer-go-tools
RUN cd /tmp/fixer-go-tools \
    && go mod download all \
    && test "$(go list -m -f '{{.Version}}' github.com/cli/cli/v2)" = "v${GH_VERSION}" \
    && test "$(go list -m -f '{{.Version}}' gitlab.com/gitlab-org/cli)" = "v${GLAB_VERSION}" \
    && go mod verify \
    && go build -mod=readonly -trimpath -o /usr/local/bin/gh github.com/cli/cli/v2/cmd/gh \
    && go build -mod=readonly -trimpath -ldflags "-X main.version=${GLAB_VERSION}" -o /usr/local/bin/glab gitlab.com/gitlab-org/cli/cmd/glab \
    && go build -mod=readonly -trimpath -o /opt/wolf/fix-tools/bin/goimports golang.org/x/tools/cmd/goimports \
    && ln -sfn /opt/wolf/fix-tools/bin/goimports /usr/local/bin/goimports \
    && gh --version \
    && glab --version \
    && goimports -h >/dev/null \
    && rm -rf /tmp/fixer-go-tools

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download && go mod verify
COPY cmd ./cmd
COPY internal ./internal
COPY plugins ./plugins
COPY scanners ./scanners
RUN CGO_ENABLED=1 go build \
      -trimpath \
      -ldflags "-s -w -X main.version=${WOLF_VERSION}" \
      -tags "fixer_runtime sqlite_omit_load_extension netgo osusergo" \
      -o /usr/local/bin/wolf ./cmd/wolf \
    && /usr/local/bin/wolf version \
    && rm -rf /src /root/.cache/go-build /root/go \
    && rm -f /usr/local/go/src/crypto/x509/platform_root_key.pem

# Start the distributable runtime from a clean layer history. Removing build
# caches in a later layer does not remove them from an OCI image, so the final
# stage deliberately copies only runtime artifacts from the build stage.
FROM debian:trixie-slim@sha256:4e401d95de7083948053197a9c3913343cd06b706bf15eb6a0c3ccd26f436a0e AS runtime

ARG WOLF_VERSION=dev
LABEL org.opencontainers.image.title="wolf-fixer" \
      org.opencontainers.image.description="Autonomous remediation worker base for The Wolf" \
      org.opencontainers.image.source="https://github.com/alphabravo-oss/thewolf" \
      org.opencontainers.image.vendor="AlphaBravo" \
      org.opencontainers.image.version="${WOLF_VERSION}" \
      dev.wolf.fixer.variant="base" \
      dev.wolf.fixer.auth-mode="none"

ENV DEBIAN_FRONTEND=noninteractive \
    WOLF_FIXER_VARIANT=base \
    GOTOOLCHAIN=local \
    PATH=/usr/local/go/bin:/home/wolf/go/bin:/usr/local/bin:/usr/bin:/bin

COPY scanners/os-packages /etc/wolf-scanners/os-packages
COPY scanners/install/os-packages.sh /usr/local/bin/install-os-packages
RUN chmod 0755 /usr/local/bin/install-os-packages \
    && /usr/local/bin/install-os-packages fixer-base \
    && rm -f /usr/local/bin/install-os-packages \
    && rm -rf /usr/lib/node_modules/npm /usr/lib/node_modules/typescript \
    && rm -f /usr/bin/npm /usr/bin/npx /usr/bin/tsc /usr/bin/tsserver

COPY --from=build /usr/local/go /usr/local/go
COPY --from=build /usr/local/bin/wolf /usr/local/bin/wolf
COPY --from=build /usr/local/bin/gh /usr/local/bin/gh
COPY --from=build /usr/local/bin/glab /usr/local/bin/glab
COPY --from=build /usr/lib/node_modules /usr/lib/node_modules
COPY --from=build /opt/wolf/fix-tools /opt/wolf/fix-tools
RUN ln -sfn ../lib/node_modules/npm/bin/npm-cli.js /usr/bin/npm \
    && ln -sfn ../lib/node_modules/npm/bin/npx-cli.js /usr/bin/npx \
    && ln -sfn ../lib/node_modules/typescript/bin/tsc /usr/bin/tsc \
    && ln -sfn ../lib/node_modules/typescript/bin/tsserver /usr/bin/tsserver \
    && for b in /opt/wolf/fix-tools/bin/*; do ln -sfn "$b" "/usr/local/bin/$(basename "$b")"; done

RUN wolf version \
    && gh --version \
    && glab --version \
    && test "$(tsc --version | awk '{print $2}')" = "6.0.3" \
    && node -e "if (require('/usr/lib/node_modules/npm/package.json').version !== '12.0.2') process.exit(1)" \
    && node -e "if (require('/usr/lib/node_modules/npm/node_modules/brace-expansion/package.json').version !== '5.0.9') process.exit(1)" \
    && node -e "if (require('/usr/lib/node_modules/npm/node_modules/picomatch/package.json').version !== '4.0.5') process.exit(1)" \
    && node -e "if (require('/usr/lib/node_modules/npm/node_modules/ip-address/package.json').version !== '10.3.1') process.exit(1)" \
    && command -v prettier \
    && command -v markdownlint \
    && command -v eslint \
    && command -v ruff \
    && command -v yamlfmt \
    && command -v shfmt \
    && command -v uv \
    && command -v hadolint \
    && command -v shellcheck \
    && command -v golangci-lint \
    && command -v taplo \
    && command -v goimports

COPY fixer/versions.env /usr/share/wolf/fixer/versions.env

RUN /usr/sbin/addgroup --gid 1000 wolf \
    && /usr/sbin/adduser --uid 1000 --gid 1000 --home /home/wolf --shell /bin/bash \
         --disabled-password --gecos '' wolf \
    && mkdir -p /home/wolf/.config /workspace \
    && chown -R wolf:wolf /home/wolf /workspace

USER wolf
WORKDIR /workspace
ENV HOME=/home/wolf

ENTRYPOINT ["/usr/local/bin/wolf", "fixer"]
