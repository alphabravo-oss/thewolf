# ============================================================
# checkov:skip=CKV_DOCKER_2 — worker container, not a service.
#
# wolf-fixer-api — API (CLI-free) engine variant
# ============================================================
# The zero-auth fallback. No agent CLI is installed; the worker drives the
# APIEngine (internal/fix/engine) which calls the configured provider
# (Anthropic / OpenAI) through internal/ai using a key from the secret
# store. Because there is nothing to `login` to, this image needs no
# interactive auth and no persisted session volume — it is "ready" the
# moment it starts and a provider key exists.
#
# Use this variant where you cannot provision an interactive CLI session
# (locked-down clusters, ephemeral Job-per-task runs, CI).
#
# Build via internal/scannerbuild FixerVariants ("api").
# ============================================================

# Pin the base by version tag (not :latest) — the scanner-image build
# subsystem always passes --build-arg WOLF_VERSION and tags the base as
# wolf-fixer:<version> alongside :latest, so this resolves to the matching
# immutable version at build time (default `dev` for manual local builds).
ARG WOLF_VERSION=dev
FROM alphabravodevops/wolf-fixer:${WOLF_VERSION} AS base

ENV WOLF_FIXER_VARIANT=api \
    WOLF_FIXER_ENGINE=api

# Nothing to install: the base already carries git, gh/glab, go, node/tsc
# and the wolf binary. The API engine returns a unified diff that wolf
# applies with `git apply` — no in-place agent edits.

# The base already creates and selects the non-root `wolf` user; restate it
# explicitly so the running user is unambiguous in this final image.
USER wolf
WORKDIR /workspace
ENV HOME=/home/wolf

ENTRYPOINT ["/usr/local/bin/wolf", "fixer"]
