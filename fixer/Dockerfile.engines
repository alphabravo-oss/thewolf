# syntax=docker/dockerfile:1.7
# check=skip=InvalidDefaultArgInFrom
# WOLF_FIXER_BASE_REF is the Debian wolf-fixer base (git, node, gh, wolf).
# This image is the independently scalable fixer worker: queue + Claude +
# Codex + OpenCode in one Debian userspace. Published to
# ghcr.io/alphabravo-oss/wolf-fixer-engines. It is not one of the locked
# four fixer variants in wolf-scanner-releases. Do not reuse the Alpine
# API image for this role.
# ============================================================
# checkov:skip=CKV_DOCKER_2 — worker container, not a service.
# ============================================================

ARG WOLF_FIXER_BASE_REF
ARG GO_IMAGE=golang:1.27.3-alpine@sha256:b8c9b82affbbb82a020bbcf998dad2ba9516944ac7e883524642a481a9505e9c

FROM ${GO_IMAGE} AS builder
RUN apk add --no-cache gcc musl-dev sqlite-dev git
WORKDIR /app
ARG TARGETARCH
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download && go mod verify
COPY . .
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_DATE=unknown
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,id=wolf-build-${TARGETARCH},target=/root/.cache/go-build CGO_ENABLED=1 go build \
    -trimpath \
    -ldflags "-s -w \
        -X main.version=${VERSION} \
        -X main.commit=${COMMIT} \
        -X main.buildDate=${BUILD_DATE} \
        -linkmode external -extldflags '-static'" \
    -tags 'sqlite_omit_load_extension netgo osusergo' \
    -o /wolf ./cmd/wolf/
COPY fixer/go-tools /tmp/fixer-go-tools
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,id=wolf-build-${TARGETARCH},target=/root/.cache/go-build cd /tmp/fixer-go-tools \
    && go build -mod=readonly -trimpath -o /goimports golang.org/x/tools/cmd/goimports

FROM ${WOLF_FIXER_BASE_REF}

ARG CLAUDE_CODE_VERSION=2.1.296
ARG CLAUDE_CODE_INTEGRITY=sha512-OX/k/rpcthMqnFKOWcpNcbiLsMKtAjLOpQNJHlYiDCFUznWCIwdRTyl/p9SdHVrsrzZuPMCNqZjnpakIni6upw==
ARG CLAUDE_CODE_LINUX_AMD64_INTEGRITY=sha512-+m01urgelnI+VJxPaKPEK0wixgq42uZ8PeCaUk5tX/8YoDBvSmC/REVQG2jQfJAr8dxunpjJ600FvLrcj1WWTw==
ARG CLAUDE_CODE_LINUX_ARM64_INTEGRITY=sha512-Q6Qh6qFmwuBG9rQFiDR6bY3XkFnwTN9AAPrnnDgBvr9sbg1Ql5wrf0lfoCDiV369EUHOzxI4i5OdHW9Vf2/oeA==
ARG CODEX_VERSION=0.162.1
ARG CODEX_INTEGRITY=sha512-NWZdi/kxyjv/8EUGFupziGU38YyleugZRM4JXgY5XFH7FUmaFA33NZS2Bmq0HPazf7S3jJQQWsZ/jAK9jsrV3Q==
ARG CODEX_LINUX_AMD64_INTEGRITY=sha512-cjK2mdHIfEepZ1lQ1MX3aTQC+8ncIsvnacl/6vI2dIIcfP8/MrhTQ2+qRlkXFNDzJSj1d36quIszP+3/4CUJWQ==
ARG CODEX_LINUX_ARM64_INTEGRITY=sha512-Ss7W/SrKtQFNaMtSojNoiykJgX+iDC8daM+YrcvgmJADtQPk0cd3w6Dna4CYH2CYvf9nQranj69fpcTzZ3sQIQ==
ARG OPENCODE_VERSION=1.19.0
ARG OPENCODE_INTEGRITY=sha512-lddJhFwZI3GLlw8VyOo4yNwBVGeVN/mxH6ORh60h69zAXL7QhjSWY9orj10rwO2kxVnxH9dh45uDCWNuiqPb8A==

ENV WOLF_FIXER_VARIANT=engines \
    WOLF_FIXER_ENGINE=auto

LABEL dev.wolf.fixer.variant="engines" \
      dev.wolf.fixer.auth-mode="oauth-or-api-key"

USER root

# Claude Code, Codex, and OpenCode — same pins as the single-engine variants.
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) \
        claude_native="@anthropic-ai/claude-code-linux-x64"; \
        claude_native_integrity="$CLAUDE_CODE_LINUX_AMD64_INTEGRITY"; \
        codex_native="${CODEX_VERSION}-linux-x64"; \
        codex_native_integrity="$CODEX_LINUX_AMD64_INTEGRITY" ;; \
      arm64) \
        claude_native="@anthropic-ai/claude-code-linux-arm64"; \
        claude_native_integrity="$CLAUDE_CODE_LINUX_ARM64_INTEGRITY"; \
        codex_native="${CODEX_VERSION}-linux-arm64"; \
        codex_native_integrity="$CODEX_LINUX_ARM64_INTEGRITY" ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 65 ;; \
    esac; \
    actual="$(npm --cache /tmp/npm-cache view "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" dist.integrity)"; \
    test "$actual" = "$CLAUDE_CODE_INTEGRITY"; \
    actual="$(npm --cache /tmp/npm-cache view "${claude_native}@${CLAUDE_CODE_VERSION}" dist.integrity)"; \
    test "$actual" = "$claude_native_integrity"; \
    npm --cache /tmp/npm-cache install --prefix /opt/wolf/claude --omit=dev \
      "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}"; \
    node /opt/wolf/claude/node_modules/@anthropic-ai/claude-code/install.cjs; \
    ln -sfn /opt/wolf/claude/node_modules/.bin/claude /usr/local/bin/claude; \
    actual="$(npm --cache /tmp/npm-cache view "@openai/codex@${CODEX_VERSION}" dist.integrity)"; \
    test "$actual" = "$CODEX_INTEGRITY"; \
    actual="$(npm --cache /tmp/npm-cache view "@openai/codex@${codex_native}" dist.integrity)"; \
    test "$actual" = "$codex_native_integrity"; \
    npm --cache /tmp/npm-cache install --prefix /opt/wolf/codex --omit=dev \
      "@openai/codex@${CODEX_VERSION}"; \
    ln -sfn /opt/wolf/codex/node_modules/.bin/codex /usr/local/bin/codex; \
    actual="$(npm --cache /tmp/npm-cache view "opencode-ai@${OPENCODE_VERSION}" dist.integrity)"; \
    test "$actual" = "$OPENCODE_INTEGRITY"; \
    npm --cache /tmp/npm-cache install --prefix /opt/wolf/opencode --omit=dev \
      "opencode-ai@${OPENCODE_VERSION}"; \
    node /opt/wolf/opencode/node_modules/opencode-ai/postinstall.mjs; \
    ln -sfn /opt/wolf/opencode/node_modules/.bin/opencode /usr/local/bin/opencode; \
    command -v claude; \
    command -v codex; \
    command -v opencode; \
    opencode --version; \
    rm -rf /tmp/npm-cache

COPY fixer/versions.env /usr/share/wolf/fixer/versions.env
COPY fixer/install-fix-tools.sh /tmp/install-fix-tools.sh
RUN chmod 0755 /tmp/install-fix-tools.sh \
    && /tmp/install-fix-tools.sh /usr/share/wolf/fixer/versions.env \
    && rm -f /tmp/install-fix-tools.sh
COPY --from=builder /goimports /opt/wolf/fix-tools/bin/goimports
RUN ln -sfn /opt/wolf/fix-tools/bin/goimports /usr/local/bin/goimports \
    && command -v goimports

# App updates reuse the engine and formatter layers above.
COPY --from=builder /wolf /usr/local/bin/wolf

USER wolf
WORKDIR /workspace
ENV HOME=/home/wolf

ENTRYPOINT ["/usr/local/bin/wolf", "fixer"]
