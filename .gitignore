# Binaries
# Use a leading slash so these only match the compiled binary at the
# repo root, not the source directory cmd/wolf/. Without the slash a
# bare 'wolf' / 'thewolf' would match any path component, silently
# excluding all changes in those directories from commits.
/wolf
/thewolf
*.exe
*.dll
*.so
*.dylib
build/

# Database
*.db
*.db-journal
*.db-shm
*.db-wal

# Environment / secrets
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Go
vendor/

# Node / Next.js
node_modules/
.next/
ui/node_modules/
ui/.next/
ui/out/

# Air (hot reload)
tmp/
.air.toml

# Ruff cache
.ruff_cache/

# Wolf runtime artifacts
.wolf/

# Scan artifacts output dir (local dev). Anchored to the repo root so it does
# NOT match the internal/artifacts/ Go source package.
/artifacts/

# Misc
-.json
*.log
