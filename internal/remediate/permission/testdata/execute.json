{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "*": "allow",
      ".github/**": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny"
    },
    "bash": {
      "*": "deny",
      "git *": "allow",
      "npm *": "allow",
      "go *": "allow",
      "make *": "allow",
      "pytest *": "allow",
      "rm -rf *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "sudo *": "deny"
    },
    "external_directory": { "*": "deny" }
  }
}
