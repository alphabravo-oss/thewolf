{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "deny",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "edit": {
      "*": "allow",
      ".github/**": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "opencode.json": "deny",
      "opencode.jsonc": "deny",
      ".opencode/**": "deny"
    },
    "bash": {
      "*": "deny",
      "git add *": "allow",
      "git commit *": "allow",
      "git checkout *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git status *": "allow",
      "go build *": "allow",
      "go test *": "allow",
      "go vet *": "allow",
      "gofmt *": "allow",
      "npm test *": "allow",
      "npm run *": "allow",
      "make *": "allow",
      "pytest *": "allow",
      "rm -rf *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "sudo *": "deny"
    },
    "external_directory": { "*": "deny" }
  }
}
