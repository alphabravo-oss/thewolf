{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "deny",
    "bash": {
      "*": "deny",
      "git log *": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "grep *": "allow",
      "cat *": "allow",
      "ls *": "allow",
      "find *": "allow"
    },
    "external_directory": { "*": "deny" }
  }
}
