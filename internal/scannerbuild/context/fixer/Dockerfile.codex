# syntax=docker/dockerfile:1.7
# check=skip=InvalidDefaultArgInFrom
# WOLF_FIXER_BASE_REF intentionally has no mutable default; the release
# pipeline must provide the verified base image by digest.
# ============================================================
# checkov:skip=CKV_DOCKER_2 — worker container, not a service.
#
# wolf-fixer-codex — CODEX engine variant
# ============================================================
# Extends the wolf-fixer base with OpenAI's Codex CLI. Like the claude
# variant it requires a one-time interactive login:
#
#   docker exec -it <container> codex login     # opens an auth URL
#
# The session is written under /home/wolf/.config (and ~/.codex). Mount a
# volume / k8s PVC at /home/wolf so the session survives restarts and the
# worker comes up "ready". The engine chain probes `codex` on PATH + a
# fast auth check before selecting it, falling back to the API engine when
# no session is present.
#
# Build via internal/scannerbuild FixerVariants ("codex").
# ============================================================

ARG WOLF_FIXER_BASE_REF
FROM ${WOLF_FIXER_BASE_REF} AS base

ARG CODEX_VERSION=0.162.1
ARG CODEX_INTEGRITY=sha512-NWZdi/kxyjv/8EUGFupziGU38YyleugZRM4JXgY5XFH7FUmaFA33NZS2Bmq0HPazf7S3jJQQWsZ/jAK9jsrV3Q==
ARG CODEX_LINUX_AMD64_INTEGRITY=sha512-cjK2mdHIfEepZ1lQ1MX3aTQC+8ncIsvnacl/6vI2dIIcfP8/MrhTQ2+qRlkXFNDzJSj1d36quIszP+3/4CUJWQ==
ARG CODEX_LINUX_ARM64_INTEGRITY=sha512-Ss7W/SrKtQFNaMtSojNoiykJgX+iDC8daM+YrcvgmJADtQPk0cd3w6Dna4CYH2CYvf9nQranj69fpcTzZ3sQIQ==

ENV WOLF_FIXER_VARIANT=codex \
    WOLF_FIXER_ENGINE=codex

LABEL dev.wolf.fixer.variant="codex" \
      dev.wolf.fixer.auth-mode="interactive-session" \
      dev.wolf.fixer.cli.version="${CODEX_VERSION}"

USER root

RUN --mount=type=cache,target=/tmp/npm-cache set -eux; \
    actual_integrity="$(npm --cache /tmp/npm-cache view "@openai/codex@${CODEX_VERSION}" dist.integrity)"; \
    test "$actual_integrity" = "$CODEX_INTEGRITY"; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) native_version="${CODEX_VERSION}-linux-x64"; native_integrity="$CODEX_LINUX_AMD64_INTEGRITY" ;; \
      arm64) native_version="${CODEX_VERSION}-linux-arm64"; native_integrity="$CODEX_LINUX_ARM64_INTEGRITY" ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 65 ;; \
    esac; \
    actual_native_integrity="$(npm --cache /tmp/npm-cache view "@openai/codex@${native_version}" dist.integrity)"; \
    test "$actual_native_integrity" = "$native_integrity"; \
    npm --cache /tmp/npm-cache install --prefix /opt/wolf/codex --omit=dev \
      "@openai/codex@${CODEX_VERSION}"; \
    ln -s /opt/wolf/codex/node_modules/.bin/codex /usr/local/bin/codex; \
    command -v codex; \
    codex --version

USER wolf
WORKDIR /workspace
ENV HOME=/home/wolf

ENTRYPOINT ["/usr/local/bin/wolf", "fixer"]
