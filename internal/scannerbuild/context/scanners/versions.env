# ============================================================
# wolf-scanners — pinned tool versions
# ============================================================
# This file is the SOURCE OF TRUTH for every scanner version that
# ships in wolf-scanners. Install scripts source this file; the
# smoke test asserts each tool reports the pinned version.
#
# When bumping a version:
#   1. Update the variable below.
#   2. Run `make scanners-build && make scanners-smoke`.
#   3. Re-run plugin parity tests (any plugin whose tool changed
#      may need its expected-output fixture refreshed).
#   4. Note the bump in CHANGELOG.md.
# ============================================================

# --- Python ecosystem (pip) ---
SEMGREP_VERSION=1.180.0
BANDIT_VERSION=1.9.4
RUFF_VERSION=0.17.0
MYPY_VERSION=2.4.0
PIP_AUDIT_VERSION=2.10.1
RADON_VERSION=6.0.1
VULTURE_VERSION=2.16
DETECT_SECRETS_VERSION=1.5.0
CHECKOV_VERSION=3.3.28
SQLFLUFF_VERSION=4.4.0

# --- Go ecosystem (go install) ---
# NOTE: bumped 2026-05 along with the Go toolchain to 1.25. Older pins
# (gosec 2.21.4, staticcheck 2024.1.1, govulncheck 1.1.3) failed `go install`
# under Go 1.25 with module-resolution errors. Keep these in sync with the
# Go toolchain version if you bump GOTC_VERSION in install/go-tools.sh.
GOSEC_VERSION=2.29.0
STATICCHECK_VERSION=0.8.2
GOVULNCHECK_VERSION=1.9.0

